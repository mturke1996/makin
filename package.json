{
  "name": "saas-build",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A premium, white-label SaaS workspace. Clone, re-theme, ship.",
  "scripts": {
    "dev": "vite",
    "dev:clean": "node -e \"const fs=require('fs'),p=require('path');const d=p.join('node_modules','.vite');if(fs.existsSync(d)){fs.rmSync(d,{recursive:true,force:true});console.log('Vite cache cleared')}\" && vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 200",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "npx -y firebase-tools@15.15.0 emulators:start --only auth,firestore,storage --project demo-makin",
    "seed:emulators": "node scripts/dev/seed-emulators.mjs",
    "dev:emulators": "vite --mode emulators",
    "test:rules": "npx -y firebase-tools@15.15.0 emulators:exec --only firestore,storage --project demo-saas-rules \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@fontsource-variable/cairo": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@phosphor-icons/react": "^2.1.10",
    "@react-pdf/renderer": "^4.9.0",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.23",
    "firebase": "^12.19.0",
    "qrcode-generator": "^1.5.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.90.0",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "postcss-selector-parser": "^7.1.6"
  }
}
